{
  "name": "karikosan",
  "version": "1.0.0",
  "private": true,
  "description": "karikosan — タスク・工程・スケジュール管理アプリ",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "sharp": "0.35.4",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
